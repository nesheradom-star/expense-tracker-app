import React, { createContext, useContext, useEffect, useMemo, useState } from 'react';
import AsyncStorage from '@react-native-async-storage/async-storage';

const AppContext = createContext(null);
export const CATEGORIES = [
  'Food',
  'Transport',
  'Housing',
  'Shopping',
  'Health',
  'Entertainment',
  'Bills',
  'Other',
];

const STORAGE_KEY = '@expense-tracker-state';

const getDemoExpenses = () => {
  const now = new Date();
  const createDate = (dayOffset) => {
    const date = new Date(now.getFullYear(), now.getMonth(), now.getDate() - dayOffset);
    return date.toISOString();
  };

  return [
    { id: '1', amount: 18.5, category: 'Food', note: 'Groceries', date: createDate(0) },
    { id: '2', amount: 42.0, category: 'Transport', note: 'Fuel', date: createDate(2) },
    { id: '3', amount: 120.0, category: 'Housing', note: 'Rent', date: createDate(6) },
    { id: '4', amount: 14.99, category: 'Entertainment', note: 'Movie night', date: createDate(8) },
    { id: '5', amount: 36.0, category: 'Shopping', note: 'Home supplies', date: createDate(12) },
  ];
};

export function AppProvider({ children }) {
  const [expenses, setExpenses] = useState(getDemoExpenses());
  const [premiumUnlocked, setPremiumUnlocked] = useState(false);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    const hydrate = async () => {
      try {
        const raw = await AsyncStorage.getItem(STORAGE_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (Array.isArray(parsed.expenses)) setExpenses(parsed.expenses);
          if (typeof parsed.premiumUnlocked === 'boolean') setPremiumUnlocked(parsed.premiumUnlocked);
        }
      } catch (error) {
        console.warn('Failed to read app data:', error);
      } finally {
        setLoading(false);
      }
    };

    hydrate();
  }, []);

  useEffect(() => {
    if (loading) return;

    const persist = async () => {
      try {
        await AsyncStorage.setItem(
          STORAGE_KEY,
          JSON.stringify({ expenses, premiumUnlocked })
        );
      } catch (error) {
        console.warn('Failed to save app data:', error);
      }
    };

    persist();
  }, [expenses, premiumUnlocked, loading]);

  const addExpense = (expense) => {
    setExpenses((current) => [
      {
        id: String(Date.now()),
        amount: Number(expense.amount),
        category: expense.category,
        note: expense.note || 'Expense',
        date: expense.date || new Date().toISOString(),
      },
      ...current,
    ]);
  };

  const deleteExpense = (id) => {
    setExpenses((current) => current.filter((expense) => expense.id !== id));
  };

  const resetDemoData = () => {
    setExpenses(getDemoExpenses());
  };

  const totals = useMemo(() => {
    const currentMonth = new Date().getMonth();
    const currentYear = new Date().getFullYear();

    const monthly = expenses.filter((expense) => {
      const d = new Date(expense.date);
      return d.getMonth() === currentMonth && d.getFullYear() === currentYear;
    });

    const totalSpent = monthly.reduce((sum, expense) => sum + Number(expense.amount), 0);
    const average = monthly.length ? totalSpent / monthly.length : 0;

    const categoryTotals = monthly.reduce((acc, expense) => {
      acc[expense.category] = (acc[expense.category] || 0) + Number(expense.amount);
      return acc;
    }, {});

    return {
      totalSpent,
      average,
      categoryTotals,
      count: monthly.length,
    };
  }, [expenses]);

  const value = {
    expenses,
    premiumUnlocked,
    setPremiumUnlocked,
    addExpense,
    deleteExpense,
    resetDemoData,
    totals,
    loading,
    categories: CATEGORIES,
  };

  return <AppContext.Provider value={value}>{children}</AppContext.Provider>;
}

export function useAppContext() {
  const context = useContext(AppContext);
  if (!context) {
    throw new Error('useAppContext must be used inside AppProvider');
  }
  return context;
}
